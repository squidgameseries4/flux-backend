"use strict";
/* File uploads. Two modes:
   - Local (default): multer -> UPLOAD_DIR, served at /uploads/<file>.
   - Cloud (optional): same multer temp storage, but on upload completion the
     file is streamed to an S3-compatible bucket (Cloudflare R2 / Backblaze B2)
     and the temp file is deleted. Returned URLs are the bucket's public URLs,
     so media survives Render restarts/redeploys (its disk is ephemeral).

   Enable cloud mode with env vars:
     S3_BUCKET, S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY, S3_PUBLIC_URL
     (optional: S3_REGION, default "auto"; S3_ACL, default unset — see step 3)
   Example R2 endpoint:  https://<account-id>.r2.cloudflarestorage.com
   Example R2 public URL: https://pub-<hash>.r2.dev   (or a custom domain)
   Example B2 endpoint:   https://s3.us-west-004.backblazeb2.com
   Example B2 public URL: https://f00X.backblazeb2.com/file/<bucket> */

const multer = require("multer");
const path = require("path");
const fs = require("fs");

const UPLOAD_DIR = process.env.UPLOAD_DIR || path.join(__dirname, "..", "uploads");
fs.mkdirSync(UPLOAD_DIR, { recursive: true });

/* Cloud mode is on only when every required S3 variable is present. */
const S3 = !!(process.env.S3_BUCKET && process.env.S3_ENDPOINT &&
  process.env.S3_ACCESS_KEY && process.env.S3_SECRET_KEY);
const S3_PUBLIC = (process.env.S3_PUBLIC_URL || "").replace(/\/$/, "");

let _s3 = null;
function s3Client() {
  if (!_s3) {
    const { S3Client } = require("@aws-sdk/client-s3");
    _s3 = new S3Client({
      region: process.env.S3_REGION || "auto",
      endpoint: process.env.S3_ENDPOINT,
      forcePathStyle: true,
      credentials: {
        accessKeyId: process.env.S3_ACCESS_KEY,
        secretAccessKey: process.env.S3_SECRET_KEY,
      },
    });
  }
  return _s3;
}

const storage = multer.diskStorage({
  destination: (req, file, cb) => cb(null, UPLOAD_DIR),
  filename: (req, file, cb) => {
    const ext = path.extname(file.originalname || "").slice(0, 8) || ".bin";
    const name = Date.now() + "-" + Math.floor(Math.random() * 1e9) + ext;
    cb(null, name);
  },
});

const MAX_MB = parseInt(process.env.MAX_UPLOAD_MB || "400", 10);

const upload = multer({
  storage,
  limits: { fileSize: MAX_MB * 1024 * 1024 },
  fileFilter: (req, file, cb) => {
    if (/^(video|image)\//.test(file.mimetype)) return cb(null, true);
    cb(new Error("Only video and image files are allowed"));
  },
});

/* Persist a multer file and return its public URL. Async: in cloud mode the
   temp file is streamed to the bucket (low memory: streams, not buffers). */
async function fileUrl(req, file) {
  if (!S3) return "/uploads/" + file.filename;
  try {
    const { PutObjectCommand } = require("@aws-sdk/client-s3");
    await s3Client().send(new PutObjectCommand({
      Bucket: process.env.S3_BUCKET,
      Key: file.filename,
      Body: fs.createReadStream(file.path),
      ContentType: file.mimetype || "application/octet-stream",
      /* Never send ACL to R2 (it ignores/errors on it); B2 users can set
         S3_ACL=public-read so files are readable via friendly URLs. */
      ...(process.env.S3_ACL ? { ACL: process.env.S3_ACL } : {}),
    }));
    try { fs.unlinkSync(file.path); } catch (e) { /* ignore */ }
    return S3_PUBLIC + "/" + file.filename;
  } catch (e) {
    console.error("[S3] upload failed, falling back to local:", e.message);
    return "/uploads/" + file.filename;
  }
}

/* Delete a stored file given the URL returned by fileUrl().
   Handles cloud URLs, local /uploads/ URLs, and not-yet-uploaded temp
   files (the image route rejects with a /uploads/ temp path). Never throws. */
async function deleteFile(url) {
  if (!url) return;
  if (S3 && S3_PUBLIC && url.startsWith(S3_PUBLIC)) {
    try {
      const { DeleteObjectCommand } = require("@aws-sdk/client-s3");
      await s3Client().send(new DeleteObjectCommand({
        Bucket: process.env.S3_BUCKET,
        Key: path.basename(url.split("?")[0]),
      }));
    } catch (e) { /* ignore */ }
    return;
  }
  if (url.startsWith("/uploads/")) {
    try { fs.unlinkSync(path.join(UPLOAD_DIR, path.basename(url))); } catch (e) { /* ignore */ }
  }
}

/* Approximate local bytes used (admin dashboard). null in cloud mode. */
function storageBytes() {
  if (S3) return null;
  let total = 0;
  try {
    for (const f of fs.readdirSync(UPLOAD_DIR)) {
      try { total += fs.statSync(path.join(UPLOAD_DIR, f)).size; } catch (e) { /* ignore */ }
    }
  } catch (e) { /* ignore */ }
  return total;
}

module.exports = { upload, fileUrl, deleteFile, storageBytes, UPLOAD_DIR, S3 };
